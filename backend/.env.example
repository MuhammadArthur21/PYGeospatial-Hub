# PyGeospatial Hub - Environment Configuration
# Copy this file to .env and adjust values

# App Settings
APP_NAME="PyGeospatial Hub"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY="change-this-to-a-random-secret-key"

# Database
DATABASE_URL="postgresql://pygeo:pygeo_password@localhost:5432/pygeospatial_hub"

# Redis
REDIS_URL="redis://localhost:6379/0"

# MinIO / S3-compatible Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="pygeo_access"
MINIO_SECRET_KEY="pygeo_secret"
MINIO_BUCKET="pygeospatial-datasets"

# Celery
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# JWT
JWT_SECRET_KEY="change-this-to-a-jwt-secret"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=1440

# Sandbox
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_CPU_LIMIT=1
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=".shp,.geojson,.tiff,.tif,.las,.laz,.kml,.csv,.gpkg"
